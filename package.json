{
  "name": "built-at-albert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "dev:functions": "npm run build && wrangler pages dev out --port 8788",
    "deploy": "npm run build && wrangler pages deploy out --project-name built-at-albert",
    "deploy:cron": "wrangler deploy --config worker-cron/wrangler.jsonc",
    "db:push": "node scripts/db-push-api.mjs",
    "verify:rules": "node scripts/verify-rules.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.1"
  }
}
