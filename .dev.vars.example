# Copy to .dev.vars for `npm run dev:functions`. Never commit .dev.vars.
#
# The browser needs no secret at all: the Supabase project URL and publishable
# key are public by design and live in src/lib/public-config.ts. Everything
# below is read only by the Pages Functions.

SUPABASE_URL="https://sdrlrksfefswxtmnjfmx.supabase.co"
SITE_URL="http://localhost:8788"

# Supabase > Project Settings > API keys > secret key
SUPABASE_SERVICE_ROLE_KEY=""

# resend.com > API keys. The sender must be on a domain you control.
RESEND_API_KEY=""
RESEND_FROM="Built at Albert <no-reply@example.com>"
RESEND_REPLY_TO=""

# Shared with the cron Worker; any long random string (openssl rand -hex 32)
CRON_SECRET=""

# Only used by scripts/db-push-api.mjs
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""
