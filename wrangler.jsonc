{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "built-at-albert",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // Required: the Supabase client relies on Node built-ins at runtime.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Public, non-secret values only. Secrets go through `wrangler secret put`.
    "NEXT_PUBLIC_SUPABASE_URL": "https://sdrlrksfefswxtmnjfmx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_qYE6EfbXOAF6PNArlxXZ7A__F1theHf",
    "NEXT_PUBLIC_SITE_URL": "https://built-at-albert.workers.dev",
    "ALLOWED_EMAIL_DOMAINS": "albertschool.com",
    "WHATSAPP_CHANNEL_URL": "https://whatsapp.com/channel/0029Vb99R1UFXUuTnGJblY2H"
  }
}
